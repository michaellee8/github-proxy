# syntax=docker/dockerfile:1

FROM golang:1.26-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/pgh-broker ./cmd/pgh-broker

FROM scratch

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/pgh-broker /usr/local/bin/pgh-broker

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/pgh-broker"]
CMD ["serve", "--listen", "0.0.0.0:8080"]
